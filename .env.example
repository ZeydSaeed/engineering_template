APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Production: LOG_STACK=json (JSON lines, request id, masked secrets) and LOG_LEVEL=info.
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# LOG_DAILY_DAYS=14

# Database names this application must refuse to use, comma-separated
# (checked at boot in production and staging, ADR-0010).
PLATFORM_DENIED_DATABASES=

# Separate from APP_KEY; chains the audit trail (ADR-0013). Generate with:
#   php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
AUDIT_HMAC_KEY=

# Security defaults (ADR-0015, ADR-0016). Production: HSTS and CSP true.
PLATFORM_HSTS=false
PLATFORM_CSP=true
PLATFORM_REQUIRE_SECOND_FACTOR=true

# PostgreSQL (scripts/db/create-local-databases.ps1 fills these locally).
# The runtime connects as the DML-only role; migrations run as the owner.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=engineering_template
# DB_USERNAME=template_app
# DB_PASSWORD=
# DB_APP_ROLE=template_app

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Production: true (the cookie then becomes __Host-<name>).
# SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
